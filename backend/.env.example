# PostgreSQL credentials (used by both db and jam services)
POSTGRES_USER=bitchord
POSTGRES_PASSWORD=bitchord_change_me
POSTGRES_DB=bitchord_telemetry

# Ports
PUBLIC_PORT=9500
ADMIN_HOST_PORT=9501
# Optional: bind dashboard only to a specific LAN/Tailscale IP instead of 0.0.0.0
# ADMIN_LISTEN_HOST=100.x.y.z

# Optional password for the /admin dashboard.
# Leave empty when port 9501 is only reachable over LAN or Tailscale.
ADMIN_SECRET=

# Proxy & server metadata
JAM_TRUST_PROXY=true
JAM_CLIENT_IP_HEADER=CF-Connecting-IP
JAM_VERSION=1.9.3
